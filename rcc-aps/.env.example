# Copy to .env locally. Never commit .env or send its contents in chat.
# Supabase Connect > Transaction pooler. Percent-encode password URL characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Only for first-time setup of the NEW assignment project:
DEMO_SETUP_CONFIRM=jc-aps
DEMO_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_16_CHARACTER_PASSWORD
DEMO_FINANCE_PASSWORD=REPLACE_WITH_UNIQUE_16_CHARACTER_PASSWORD
DEMO_EMPLOYEE_PASSWORD=REPLACE_WITH_UNIQUE_16_CHARACTER_PASSWORD
# If needed, use the Supabase root certificate PEM with literal \n separators:
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
