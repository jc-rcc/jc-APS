{
  "name": "rcc-aps",
  "version": "1.0.0",
  "description": "Republic Central Colleges - Automated Payroll System",
  "main": "server/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev": "node --env-file-if-exists=.env server/server.js",
    "lint": "node scripts/checks.js lint",
    "test": "node scripts/checks.js test",
    "db:bootstrap-demo": "node --env-file-if-exists=.env scripts/bootstrap-demo.js",
    "test:integration": "node test/database-upgrade.integration.js && node test/google-sso.integration.js"
  },
  "keywords": [
    "payroll",
    "rcc",
    "aps",
    "philippines"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.23.1"
  }
}
